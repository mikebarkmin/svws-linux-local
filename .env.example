# Copied to .env by `./svws setup` (the passwords are replaced by random values).
# Local test environment only – do not use for real school data.

# --- Versions -------------------------------------------------------------------
# SchILD-NRW 3 release from github.com/SVWS-NRW/Schild-NRW-3 (e.g. 3.6.0) or "latest"
SCHILD_VERSION=latest
# svwsnrw/svws-server image tag; "auto" = the version SchILD expects (its server.json)
SVWS_VERSION=auto
# SVWS-Tools release from github.com/SVWS-NRW/SVWS-Tools (e.g. 1.5.1) or "latest"
SVWS_TOOLS_VERSION=latest

# --- Wine -----------------------------------------------------------------------
# Portable Wine build; "wow64" runs 32-bit SchILD without 32-bit system libraries
WINE_URL=https://github.com/Kron4ek/Wine-Builds/releases/download/11.20/wine-11.20-amd64-wow64.tar.xz
# Folder with Microsoft TrueType fonts (segoeui.ttf, tahoma.ttf, …) – optional
FONT_SRC=~/.local/share/fonts/Microsoft

# --- Ports (only reachable from this computer) -----------------------------------
SVWS_PORT=8443
DB_PORT=3306

# --- Database -------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=svwsdb
MARIADB_USER=svwsuser
# Entered by hand in SchILD_DBConfig – the database is only reachable from this computer
MARIADB_PASSWORD=svwspass

# --- TLS (the server creates its certificate on first start) -----------------------
SVWS_TLS_KEYSTORE_PATH=.
SVWS_TLS_KEYSTORE_PASSWORD=change-me
SVWS_TLS_KEY_ALIAS=svws
SVWS_TLS_CERT_CN=localhost
